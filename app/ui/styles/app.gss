Form.QWidget{border: 2px solid #f28223;}

QWidget{
	background-color: #f8f8f2;
}

#Title_label.QLabel {
    color: #2D2A26;
    font: 20pt "Tahoma";
    font-weight: 700;
}

QLabel#label_filter_title {
color: #262626;
font: 14pt "Tahoma";
font-weight: 700;
}

QLabel {
color: #262626;
font: 10pt "Tahoma";
}

QPushButton {
	border: 2px solid #f09d54;
	border-radius: 5px;
	background-color: #f8f8f2;
	color: #964b09;
	font: 10pt "Tahoma";
}

QPushButton:hover {
	background-color: #f28223;
	color: #ffffff;
}

QPushButton:pressed {
	background-color: #f28223;
	border: 2px solid #f28223;
	color: #ffffff;
}

QTableWidget {	
	background-color: #f8f8f2;
	padding: 10px;
	border-radius: 5px;
	gridline-color: #f8994a;
    outline: none;
	color: #262626;
}
QTableWidget::item{
	border-color: #f8994a;
	padding-left: 5px;
	padding-right: 5px;
	gridline-color: #f8994a;
	color: #262626;
	padding: 1px;
    font: 7pt "Tahoma"; 
}
QTableWidget::item:selected{
	background-color: #f28223;
    color: #ffffff;
}
QTableWidget::item:editable {
	background-color: #ffffff;
	border: 1px solid #ffffff;
}
QTableWidget::item:focus {
	background-color: #f28223;
	border: 1px solid #ffffff;
    color: #ffffff;
}
QTableWidget QLineEdit {
	background-color: #ffffff;
	color: #262626;
	border: 1px solid #ff9900;
	padding: 1px;
}

QHeaderView::section{
	background-color: #f8f8f2;
	border: none;
	border-style: none;
}
QTableWidget::horizontalHeader {	
	background-color: #f8994a;
	font: 10pt "Tahoma";
}
QHeaderView::section:horizontal {
    border: 1px solid #f8994a;
	background-color: #ffd4af;
	padding: 3px;
	border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    color: #262626;
}
QHeaderView::section:vertical {
    border: 1px solid #f8994a;
	color: #262626;
}

QLineEdit {
	background-color: #f8f8f2;
	border-radius: 5px;
	border: 1px solid #f09d54;
	padding-left: 10px;
	selection-color: rgb(255, 255, 255);
	selection-background-color: #f28223;
    color: #262626;
}
QLineEdit:hover {
	border: 1px solid #f28223;
}
QLineEdit:focus {
	border: 1px solid #f28223;
}

/* Стили для множественного выбора */
QListWidget {
    background-color: #f8f8f2;
    border: 1px solid #f09d54;
    border-radius: 5px;
    color: #262626;
    font: 10pt "Tahoma";
}

QListWidget::item {
    padding: 5px;
    border-bottom: 1px solid #f8994a;
}

QListWidget::item:selected {
    background-color: #f28223;
    color: #ffffff;
}

QListWidget::item:hover {
    background-color: #ffd4af;
}

/* Улучшенная видимость чекбоксов */
QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    border: 1px solid #f09d54;
    background-color: #f8f8f2;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    border: 1px solid #f28223;
    background-color: #f28223;
    border-radius: 3px;
    image: url(:/icon/icon/check.svg);
}

QCheckBox::indicator:hover {
    border: 1px solid #f28223;
}

QComboBox {
	background-color: #f8f8f2;
	border-radius: 5px;
	border: 1px solid #f09d54;
	padding-left: 10px;
	selection-color: #f28223;
	selection-background-color: #f28223;
    color: #262626;
	font: 9pt "Tahoma";
}
QComboBox:hover {
	border: 1px solid #f28223;
	
}
QComboBox:focus {
	border: 1px solid #f28223;
}

QComboBox QAbstractItemView::item {
	color: #262626;
}
QComboBox QAbstractItemView::item::selected {
	background-color: #f09d54;
	color: #ffffff;
}

QComboBox::down-arrow {
	
	image: url(:/icon/icon/chevron-down — копия — копия.svg);
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 15px;
    border-left-width: 1px;
    border-left-color: #f8994a;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
	color: #262626;
}

QScrollBar:horizontal {
    border: none;
    background: #f8994a;
    height: 8px;
    margin: 0px 21px 0 21px;
	border-radius: 0px;
}
QScrollBar::handle:horizontal {
    background: #f6c294;
    min-width: 20px;
	border-radius: 4px
}
QScrollBar::add-line:horizontal {
    border: none;
    background: #f8994a;
    width: 20px;
	border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    subcontrol-position: right;
    subcontrol-origin: margin;
}
QScrollBar::sub-line:horizontal {
    border: none;
    background: #f8994a;
    width: 20px;
	border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}
QScrollBar::up-arrow:horizontal, QScrollBar::down-arrow:horizontal
{
     background: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal
{
     background: none;
}
 QScrollBar:vertical {
	border: none;
    background-color: #f8994a;
    width: 8px;
    margin: 21px 0 21px 0;
	border-radius: 0px;
 }
 QScrollBar::handle:vertical {	
	background: #f6c294;
    min-height: 25px;
	border-radius: 4px
 }
 QScrollBar::add-line:vertical {
     border: none;
    background: #f8994a;
     height: 20px;
	border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
     subcontrol-position: bottom;
     subcontrol-origin: margin;
 }
 QScrollBar::sub-line:vertical {
	border: none;
    background: #f8994a;
     height: 20px;
	border-top-left-radius: 4px;
    border-top-right-radius: 4px;
     subcontrol-position: top;
     subcontrol-origin: margin;
 }
 QScrollBar::up-arrow:vertical, QScrollBar::down-arrow:vertical {
     background: none;
 }

 QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
     background: none;
 }

QDateEdit {
    background-color: #f8f8f2;
    border-radius: 5px;
    border: 1px solid #f09d54;
    padding-left: 10px;
    padding-right: 10px;
    color: #262626;
    font: 10pt "Tahoma";
    min-width: 80px;
}

QDateEdit:hover {
    border: 1px solid #f28223;
}

QDateEdit:focus {
    border: 1px solid #f28223;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-left-width: 1px;
    border-left-color: #f8994a;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: #f8f8f2;
}

QDateEdit::down-arrow {
	image: url(:/icon/icon/chevron-down — копия — копия.svg);
    width: 16px;
    height: 16px;
}

/* Calendar Styling */
QCalendarWidget {
    background-color: #f8f8f2;
    border: 1px solid #f28223;
    color: #262626;
}

QCalendarWidget QWidget {
    color: #262626;
}

QCalendarWidget QAbstractItemView {
    background-color: #f8f8f2;
    selection-background-color: #f28223;
    selection-color: #ffffff;
}

QCalendarWidget QToolButton {
    background-color: #ffd4af;
    color: #262626;
    font: 10pt "Tahoma";
    border-radius: 3px;
    padding: 5px;
}

QCalendarWidget QToolButton:hover {
    background-color: #f28223;
    color: #ffffff;
}

QCalendarWidget QMenu {
    background-color: #f8f8f2;
    border: 1px solid #f28223;
}

QCalendarWidget QSpinBox {
    background-color: #f8f8f2;
    color: #262626;
    border: 1px solid #f09d54;
}

QCalendarWidget QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 15px;
    border-left-width: 1px;
    border-left-color: #f8994a;
    border-left-style: solid;
}

QCalendarWidget QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 15px;
    border-left-width: 1px;
    border-left-color: #f8994a;
    border-left-style: solid;
}

QCalendarWidget QSpinBox::up-arrow {
	image: url(:/icon/icon/chevron-up — копия — копия.svg);
    width: 10px;
    height: 10px;
}

QCalendarWidget QSpinBox::down-arrow {
	image: url(:/icon/icon/chevron-down — копия — копия.svg);
    width: 10px;
    height: 10px;
}

QTabWidget::pane {
    border: none;
    background: #f8f8f2;
}

QTabBar::tab {
    background-color: #ffd4af;
    color: #262626;
    padding: 6px 12px;
    min-height: 24px;
    border: 1px solid #f8994a;
    border-bottom: none;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #f28223;
    color: #ffffff;
}

QTabBar::tab:!selected {
    background-color: #ffd4af;
    color: #262626;
}

QTabBar::tab:hover:!selected {
    background-color: #f6c294;
    color: #262626;
}

QRadioButton {
    spacing: 6px;
    color: #262626;
    font-family: Tahoma;
    font-size: 10pt;
    background: transparent;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1px solid #ff9900;
    background-color: #ffffff;
}

QRadioButton::indicator:hover {
    border: 1px solid #ff9900;
    background-color: #ffffff;
}

QRadioButton::indicator:unchecked {
    border: 1px solid #ff9900;
    background-color: #ffffff;
}

QRadioButton::indicator:checked {
    border: 1px solid #ff9900;
    background-color: #f28223;
}

QRadioButton:disabled {
    color: #aaaaaa;
}

QRadioButton::indicator:disabled {
    border: 1px solid #dddddd;
    background-color: #f5f5f5;
}