  <property name="styleSheet">
   <string notr="true">/* ===== BASE PREVIEW STYLE FOR DESIGNER ===== */

QWidget {
    background-color: #f8f8f2;
    color: #262626;
    font: 10pt &quot;Tahoma&quot;;
}

/* ===== LABELS ===== */

QLabel {
    color: #262626;
}

#Title_label {
    font: 16pt &quot;Tahoma&quot;;
    font-weight: 700;
    color: #2D2A26;
}

QLabel#label_filter_title {
    font: 14pt &quot;Tahoma&quot;;
    font-weight: 700;
}

/* ===== INPUTS ===== */

QLineEdit, QComboBox, QDateEdit {
    border: 1px solid #f09d54;
    border-radius: 3px;
    padding: 2px;
    background-color: #ffffff;
    color: #262626;
}

/* ===== BUTTONS ===== */

QPushButton {
    border: 1px solid #f09d54;
    border-radius: 5px;
    background-color: #f8f8f2;
    color: #964b09;
    padding: 4px;
}

/* ===== TABLE ===== */

QTableWidget {
    background-color: #ffffff;
    gridline-color: #f28223;
    selection-background-color: #f5d3b5;
    selection-color: #262626;
}

QHeaderView::section {
    background-color: #f5d3b5;
    border: 1px solid #f28223;
    padding: 3px;
}

/* ===== FRAMES ===== */

QFrame#frame_LeftPanel, 
QFrame#frame_RightPanel {
    border: 1px solid #f28223;
    border-radius: 5px;
}

/* ===== SCROLL ===== */

QScrollBar:vertical {
    background: #f8f8f2;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #f28223;
    border-radius: 4px;
}</string>
