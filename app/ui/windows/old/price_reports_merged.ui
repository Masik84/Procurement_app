  <property name="styleSheet">
   <string notr="true">Form.QWidget{border: 2px solid #f28223;}

QWidget{
    background-color: #f8f8f2;
}

#Title_label.QLabel {
    color: #2D2A26;
    font: 20pt &quot;Tahoma&quot;;
    font-weight: 700;
}

QLabel#label_filter_title {
    color: #262626;
    font: 14pt &quot;Tahoma&quot;;
    font-weight: 700;
}

QLabel {
    color: #262626;
    font: 10pt &quot;Tahoma&quot;;
}

QPushButton {
    border: 2px solid #f09d54;
    border-radius: 5px;
    background-color: #f8f8f2;
    color: #964b09;
    font: 10pt &quot;Tahoma&quot;;
}

QPushButton:hover {
    background-color: #f28223;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #f28223;
    border: 2px solid #f28223;
    color: #ffffff;
}

QTableWidget {
    background-color: #f8f8f2;
    padding: 10px;
    border-radius: 5px;
    gridline-color: #f8994a;
    outline: none;
    color: #262626;
}
QTableWidget::item{
    border-color: #f8994a;
    padding-left: 5px;
    padding-right: 5px;
    gridline-color: #f8994a;
    color: #262626;
    padding: 1px;
    font: 7pt &quot;Tahoma&quot;;
}
QTableWidget::item:selected{
    background-color: #f28223;
    color: #ffffff;
}
QTableWidget::item:editable {
    background-color: #fff5cc;
    border: #ffffff;
}
QTableWidget::item:focus {
    background-color: #f28223;
    border: 1px solid #ff9900;
    padding: 1px;
}
QHeaderView::section{
    background-color: #f8f8f2;
    border: none;
    border-style: none;
}
QTableWidget::horizontalHeader {
    background-color: #f8994a;
    font: 10pt &quot;Tahoma&quot;;
}
QHeaderView::section:horizontal {
    border: 1px solid #f8994a;
    background-color: #ffd4af;
    padding: 3px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    color: #262626;
}
QHeaderView::section:vertical {
    border: 1px solid #f8994a;
    color: #262626;
}

QLineEdit {
    background-color: #f8f8f2;
    border-radius: 5px;
    border: 1px solid #f09d54;
    padding-left: 10px;
    padding: 1px;
    selection-color: rgb(255, 255, 255);
    selection-background-color: #f28223;
    color: #262626;
}
QLineEdit:hover {
    border: 1px solid #f28223;
}
QLineEdit:focus {
    border: 1px solid #f28223;
}

QListWidget {
    background-color: #f8f8f2;
    border: 1px solid #f09d54;
    border-radius: 5px;
    color: #262626;
    font: 10pt &quot;Tahoma&quot;;
}
QListWidget::item {
    padding: 5px;
    border-bottom: 1px solid #f8994a;
}
QListWidget::item:selected {
    background-color: #f28223;
    color: #ffffff;
}
QListWidget::item:hover {
    background-color: #ffd4af;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}
QCheckBox::indicator:unchecked {
    border: 1px solid #f09d54;
    background-color: #f8f8f2;
    border-radius: 3px;
}
QCheckBox::indicator:checked {
    border: 1px solid #f28223;
    background-color: #f28223;
    border-radius: 3px;
    image: url(:/icon/icon/check.svg);
}
QCheckBox::indicator:hover {
    border: 1px solid #f28223;
}

QComboBox {
    background-color: #f8f8f2;
    border-radius: 5px;
    border: 1px solid #f09d54;
    padding-left: 10px;
    padding: 1px;
    selection-color: #f28223;
    selection-background-color: #f28223;
    color: #262626;
    font: 9pt &quot;Tahoma&quot;;
}
QComboBox:hover {
    border: 1px solid #f28223;
}
QComboBox:focus {
    border: 1px solid #f28223;
}
QComboBox QAbstractItemView::item {
    color: #262626;
}
QComboBox QAbstractItemView::item::selected {
    background-color: #f09d54;
    color: #ffffff;
}
QComboBox::down-arrow {
    image: url(:/icon/icon/chevron-down — копия — копия.svg);
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 15px;
    border-left-width: 1px;
    border-left-color: #f8994a;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    color: #262626;
}

QScrollBar:horizontal {
    border: none;
    background: #f8994a;
    height: 8px;
    margin: 0px 21px 0 21px;
    border-radius: 0px;
}
QScrollBar::handle:horizontal {
    background: #f6c294;
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::add-line:horizontal {
    border: none;
    background: #f8994a;
    width: 20px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    subcontrol-position: right;
    subcontrol-origin: margin;
}
QScrollBar::sub-line:horizontal {
    border: none;
    background: #f8994a;
    width: 20px;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}
QScrollBar:vertical {
    border: none;
    background: #f8994a;
    width: 8px;
    margin: 21px 0 21px 0;
    border-radius: 0px;
}
QScrollBar::handle:vertical {
    background: #f6c294;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::add-line:vertical {
    border: none;
    background: #f8994a;
    height: 20px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}
QScrollBar::sub-line:vertical {
    border: none;
    background: #f8994a;
    height: 20px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QRadioButton {
    spacing: 6px;
    color: #262626;
    font-family: Tahoma;
    font-size: 10pt;
    background: transparent;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1px solid #ff9900;
    background-color: #ffffff;
}
QRadioButton::indicator:hover {
    border: 1px solid #ff9900;
    background-color: #ffffff;
}
QRadioButton::indicator:unchecked {
    border: 1px solid #ff9900;
    background-color: #ffffff;
}
QRadioButton::indicator:checked {
    border: 1px solid #ff9900;
    background-color: #f28223;
}

QFrame#frame_LeftPanel, QFrame#frame_RightPanel, QFrame#frame_bottom_bar {
    border: 1px solid #f09d54;
    border-radius: 8px;
}</string>
